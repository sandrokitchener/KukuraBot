{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Questing Beast",
  "version": "0.1.0",
  "identifier": "com.robodoge.console",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:3037",
    "beforeDevCommand": "bun run dev:lan",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Questing Beast",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
