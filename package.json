{
  "name": "questing-beast",
  "version": "0.1.0",
  "description": "Desktop and Android control console for Questing Beast / DOGZILLA.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node --watch server.mjs",
    "dev:bun": "bun --watch server.mjs",
    "dev:lan": "node --watch scripts/start-lan-server.mjs",
    "start": "node scripts/start-clean.mjs",
    "start:bun": "bun server.mjs",
    "start:pi": "node run.mjs --host 0.0.0.0",
    "server": "node server.mjs",
    "fake:robot-state": "node scripts/fake-robot-state-client.mjs",
    "dogzilla:capture-pose": "node scripts/capture-dogzilla-map-pose.mjs",
    "dogzilla:migrate-waypoints": "node scripts/migrate-waypoints-to-appmap.mjs",
    "dogzilla:review-waypoint-proposal": "node scripts/review-dogzilla-waypoint-proposal.mjs",
    "dogzilla:validate-waypoints": "node scripts/validate-dogzilla-waypoints.mjs",
    "dogzilla:probe-nav": "node scripts/probe-dogzilla-nav-readiness.mjs",
    "dogzilla:set-origin": "node scripts/set-dogzilla-map-origin.mjs",
    "dogzilla:start-map-pose": "powershell -ExecutionPolicy Bypass -File scripts/start-dogzilla-map-pose-ssh.ps1",
    "dogzilla:start-navigation": "powershell -ExecutionPolicy Bypass -File scripts/start-dogzilla-navigation-ssh.ps1",
    "cli": "node cli.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:android:init": "tauri android init --ci",
    "tauri:android:build": "node scripts/build-android-apk.mjs",
    "tauri:android:run": "tauri android run",
    "desktop": "electron .",
    "desktop:build": "node scripts/build-electron-desktop.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@moonshine-ai/moonshine-js": "^0.1.29",
    "@ricky0123/vad-web": "^0.0.24",
    "headroom-ai": "^0.22.4",
    "mermaid": "^11.15.0",
    "openrtk": "^0.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.robodoge.questingbeast.desktop",
    "productName": "Questing Beast Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "public/**/*",
      "config/**/*",
      "lib/**/*",
      "sidecars/**/*",
      "scripts/**/*",
      "run.mjs",
      "server.mjs",
      "cli.mjs",
      "package.json"
    ],
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Questing-Beast-Desktop-${version}-${arch}.exe"
    }
  }
}
